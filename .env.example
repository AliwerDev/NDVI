# Copy this file to .env and change the values. Do not commit .env.

# Postgres container (used by the postgis/postgis image)
POSTGRES_USER=ndvi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ndvi
# Port on your computer. Change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# App
APP_ENV=development
LOG_LEVEL=INFO

# Host "db" is the service name in docker-compose.
# If you run the app outside Docker, use "localhost:<POSTGRES_HOST_PORT>" instead of "db:5432".
DATABASE_URL=postgresql+psycopg://ndvi:change-me@db:5432/ndvi

# Satellite data (Microsoft Planetary Computer, no account needed)
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_COLLECTION=sentinel-2-l2a
# Max scene cloud cover in percent (for the whole tile, not for the field)
MAX_CLOUD_COVER=20

# NDVI
# Folder for NDVI COG files
DATA_DIR=data
# Share of field pixels (0..1) that must be clear. Cloudier scenes are skipped.
MIN_CLEAR_FRACTION=0.8

# Alerts and scheduler
# Alert when mean NDVI falls by at least this much since the previous observation
NDVI_DROP_THRESHOLD=0.15
# Water stress: alert when mean NDMI goes below the first value, or falls by at least the second value
NDMI_STRESS_THRESHOLD=0.0
NDMI_DROP_THRESHOLD=0.10
# Nitrogen: NDRE below the low value is a likely shortage, at or above the ok value is enough
NDRE_LOW_THRESHOLD=0.20
NDRE_OK_THRESHOLD=0.30
# No nitrogen advice when mean NDVI is below this value (sparse plants, bare soil)
NDRE_MIN_NDVI=0.30
SCHEDULER_TIMEZONE=Asia/Tashkent
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0
SCHEDULER_LOOKBACK_DAYS=10

# Weather (Open-Meteo, no account needed). The free API is for non-commercial use only.
# For a commercial plan, set the URLs and the key that Open-Meteo gives you.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
WEATHER_TIMEOUT_SECONDS=20
# Past days and forecast days that the daily update stores
WEATHER_PAST_DAYS=7
WEATHER_FORECAST_DAYS=7
# Frost and heat warnings for the next N forecast days, in degrees Celsius
FROST_THRESHOLD_C=0
HEAT_THRESHOLD_C=40
WEATHER_ALERT_DAYS=3
# Warnings go only to fields with growing plants: NDVI >= NDRE_MIN_NDVI in the last N days
GROWING_LOOKBACK_DAYS=30
# Irrigation advice: water loss of the last 7 days (ET0 minus rain) that needs watering, in mm,
# and the rain of the next 3 days that lets the farmer wait, in mm
IRRIGATION_DEFICIT_MM=20
RAIN_SKIP_MM=10
# Spray and fertilizer day: max rain in mm and max wind in m/s of a forecast day
SPRAY_MAX_RAIN_MM=1
SPRAY_MAX_WIND=5

# Telegram. Get a token from @BotFather. Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Accounts: login session lifetime in days, Telegram login/link code lifetime in minutes
SESSION_DAYS=30
TELEGRAM_CODE_MINUTES=10

# Comma-separated browser origins that can call the API (the frontend)
CORS_ORIGINS=http://localhost:3000

# Database for pytest (run on your computer, so the host is localhost).
# The tests create this database if it does not exist. Remove the line to skip the database tests.
TEST_DATABASE_URL=postgresql+psycopg://ndvi:change-me@localhost:5432/ndvi_test
