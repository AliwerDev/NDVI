# Copy this file to .env and change the values. Do not commit .env.

# Postgres container (used by the postgis/postgis image)
POSTGRES_USER=ndvi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ndvi
# Port on your computer. Change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# App
APP_ENV=development
LOG_LEVEL=INFO

# Host "db" is the service name in docker-compose.
# If you run the app outside Docker, use "localhost:<POSTGRES_HOST_PORT>" instead of "db:5432".
DATABASE_URL=postgresql+psycopg://ndvi:change-me@db:5432/ndvi

# Satellite data (Microsoft Planetary Computer, no account needed)
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_COLLECTION=sentinel-2-l2a
# Max scene cloud cover in percent (for the whole tile, not for the field)
MAX_CLOUD_COVER=20

# NDVI
# Folder for NDVI COG files
DATA_DIR=data
# Share of field pixels (0..1) that must be clear. Cloudier scenes are skipped.
MIN_CLEAR_FRACTION=0.8

# Alerts and scheduler
# Alert when mean NDVI falls by at least this much since the previous observation
NDVI_DROP_THRESHOLD=0.15
SCHEDULER_TIMEZONE=Asia/Tashkent
SCHEDULER_HOUR=7
SCHEDULER_MINUTE=0
SCHEDULER_LOOKBACK_DAYS=10

# Telegram. Get a token from @BotFather. Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Database for pytest (run on your computer, so the host is localhost).
# The tests create this database if it does not exist. Remove the line to skip the database tests.
TEST_DATABASE_URL=postgresql+psycopg://ndvi:change-me@localhost:5432/ndvi_test
